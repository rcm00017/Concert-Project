

@model SearchEventsViewModel
@{
    ViewData["Title"] = "SearchEvents";
}
<div class="row">
    <div class="col-md-6">
<h1>Search Events</h1>
</div>
<div class="col-md-6" style="text-align: right">
<a class="btn btn-success" asp-controller="Event" asp-action="AddEvent">New Event</a>
</div>
</div>
<form asp-controller="Event" asp-action="SearchEventsResult" method="get">
    <div class="row">
         <div class="form-group" col-md-4>
            <label class="form-label"> Date Time</label>
            <input class="form-control" asp-for="DateTime" />

        </div>

         <div class="form-group" col-md-8>
            <label class="form-label"> Event Name</label>
             <input class="form-control" asp-for="EventName" />

         </div>
    </div>
    

    <div class="row">
        <div class="form-group" col-md-4>
             <label class="form-label"> Artist</label>
             <select class="form-control" asp-for="ArtistID" asp-items="@ViewBag.ArtistDropdown">
            <option value=null> None Selected</option>
            </select>


         </div>
        <div class="form-group" col-md-4>
             <label class="form-label"> Venue</label>
             <select class="form-control" asp-for="VenueID" asp-items="@ViewBag.VenueDropdown">
            <option value=null> None Selected</option>
            </select>


        </div>
        <div class="form-group" col-md-4>
             <label class="form-label"> Genre</label>
             <select class="form-control" asp-for="GenreID" asp-items="@ViewBag.GenreDropdown">
            <option value=null> None Selected</option>
            </select>


         </div>
    </div>
   

    <br/>


    <button class="btn btn-primary" type="submit">Search</button>



</Form>

@if(Model.SearchResult != null){
    <br/>
    <hr/>
    <br/>
@if(Model.SearchResult.Any()){
<table class="table table-bordered table-striped">

    <thead>
        <tr>
        <th> Date Time</th>
        <th> Event Name</th>
        <th>Artist(s)</th>
        <th>Venue</th>
        <th>Details</th>
        @if (User.IsInRole("Employee"))
        {
            <th>Actions</th>
        }
        </tr>
    </thead>
    <tbody>
        @foreach(Event currentEvent in Model.SearchResult)
        {
            <tr>
                @if (currentEvent.DateTime != null)
                {
                 <td>@currentEvent.DateTime</td>
                }
                else
                { 
                  <td>TBD</td>

                }
                
                <td>
                    <a asp-controller="Event" asp-action="ViewEventDetails" asp-route-eventID="@currentEvent.EventID">
                    @currentEvent.EventName
                    </a>
                </td>
                        <td>
                            @if (currentEvent.Artists.Any())
                            {
                                <ul>
                                @foreach (Artist artist in @currentEvent.Artists)
                            {
                             <li> @artist.FullName</li>
                            }
                                </ul>
                            
                            }
                            else
                            {
                                <span>Artist TBD</span>
                            }
                        </td>
                        <td>
                            <p>@currentEvent.Venue.VenueName</p>
                            <p>@currentEvent.Venue.AddressFriendlyName</p>

                        </td>
                           @if (User.IsInRole("Employee"))    
                           {
                            <td>
                                <a class="btn btn-warning" asp-controller="Event" asp-action="EditEvent" asp-route-eventID="@currentEvent.EventID">Edit</a>
                                @if(!(currentEvent.DateTime.Value <= DateTime.Now) || currentEvent.Tickets.Any())
                                {
                                <a class="btn btn-danger" asp-controller="Event" asp-action="ConfirmDeleteEvent" asp-route-eventID="@currentEvent.EventID">Delete</a>
                                }
                        </td>
                        }
                        
            </tr>
        }

    </tbody>
        </table>

    }
    else
    {
     <h3 class="text-danger">No Search Results</h3>   
    }
}


